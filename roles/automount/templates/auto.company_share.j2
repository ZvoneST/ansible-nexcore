# Managed by Ansible — do not edit manually
# Direct-map entries: each key is the absolute mount point inside the user's
# home. Every user's Company_Share points at the SAME shared directory, so all
# staff see the same files. nfs_share_path lives in group_vars/db.yml, so read
# it from the NFS server's hostvars — it is not defined on web-group hosts
# otherwise.
{% for user in nexcore_users %}
/home/{{ user.name }}/Company_Share  -rw,sync,soft  {{ hostvars['serverb']['ansible_host'] }}:{{ hostvars['serverb']['nfs_share_path'] }}
{% endfor %}
