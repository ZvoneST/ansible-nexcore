# Managed by Ansible — do not edit manually
<VirtualHost *:80>
    ServerName {{ wiki_fqdn }}
    DocumentRoot {{ wiki_root }}

    <Directory {{ wiki_root }}>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog  /var/log/httpd/{{ wiki_fqdn }}-error.log
    CustomLog /var/log/httpd/{{ wiki_fqdn }}-access.log combined
</VirtualHost>
